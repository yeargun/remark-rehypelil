export extern class HastOptions {
  JsValue allowDangerousHtml;
}

export extern class PluginHost {
  JsValue data;
}

export bool optionFlag(JsValue value, bool fallback) {
  if (JS.isUndefined(value) || JS.isNullish(value)) {
    return fallback;
  }
  return value.truthy();
}

export int arrLen(JsValue arr) {
  return JS.number(arr["length"]).toInt();
}

export void pushNode(JsValue arr, JsValue item) {
  JS.push(arr, item);
}

export string asString(JsValue value) {
  if (value is string) {
    return value;
  }
  if (JS.isUndefined(value) || JS.isNullish(value)) {
    return "";
  }
  return JS.string(value);
}

export string nodeType(JsValue node) {
  JsValue t = node["type"];
  if (t is string) {
    return t;
  }
  return "";
}

export JsValue jsNull() {
  return JSON.parse("null");
}

export JsValue h(string tag, JsValue properties, JsValue children) {
  return JS.object("type", "element", "tagName", tag, "properties", properties, "children", children);
}

export JsValue hText(string value) {
  return JS.object("type", "text", "value", value);
}

export JsValue hRoot(JsValue children) {
  return JS.object("type", "root", "children", children);
}

export JsValue emptyProps() {
  return JS.object();
}

export bool allowHtmlFrom(JsValue self, JsValue options) {
  HastOptions direct = JS.assume(JS.object());
  if (!JS.isUndefined(options) && !JS.isNullish(options)) {
    direct = JS.assume(options);
  }
  bool allow = optionFlag(direct.allowDangerousHtml, false);
  PluginHost host = JS.assume(self);
  JsValue dataFn = host.data;
  if (JS.typeOf(dataFn) == "function") {
    JsValue bag = JS.call(dataFn, self);
    if (!JS.isUndefined(bag) && !JS.isNullish(bag)) {
      JsValue settings = JS.get(bag, "settings");
      if (!JS.isUndefined(settings) && !JS.isNullish(settings)) {
        HastOptions fromData = JS.assume(settings);
        allow = optionFlag(direct.allowDangerousHtml, optionFlag(fromData.allowDangerousHtml, false));
      }
    }
  }
  return allow;
}
