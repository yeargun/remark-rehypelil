import { arrLen, asString, emptyProps, h, hRoot, hText, nodeType, pushNode } from "./host.lil";

JsValue all(JsValue nodes, bool allowHtml) {
  JsValue out = JS.array();
  if (!JS.isArray(nodes)) {
    return out;
  }
  int n = arrLen(nodes);
  int i = 0;
  while (i < n) {
    JsValue child = one(nodes[i], allowHtml);
    if (!JS.isUndefined(child) && !JS.isNullish(child)) {
      if (JS.isArray(child)) {
        int k = 0;
        int kn = arrLen(child);
        while (k < kn) {
          pushNode(out, child[k]);
          k = k + 1;
        }
      } else {
        pushNode(out, child);
      }
    }
    i = i + 1;
  }
  return out;
}

JsValue classNames(string a, string b) {
  JsValue list = JS.array();
  JS.push(list, a);
  if (b.length > 0) {
    JS.push(list, b);
  }
  return JS.object("className", list);
}

JsValue one(JsValue node, bool allowHtml) {
  string t = nodeType(node);
  if (t == "root") {
    return hRoot(all(node["children"], allowHtml));
  }
  if (t == "paragraph") {
    return h("p", emptyProps(), all(node["children"], allowHtml));
  }
  if (t == "heading") {
    int depth = JS.number(node["depth"]).toInt();
    if (depth < 1) {
      depth = 1;
    }
    if (depth > 6) {
      depth = 6;
    }
    return h("h" + depth.toString(), emptyProps(), all(node["children"], allowHtml));
  }
  if (t == "thematicBreak") {
    return h("hr", emptyProps(), JS.array());
  }
  if (t == "blockquote") {
    return h("blockquote", emptyProps(), all(node["children"], allowHtml));
  }
  if (t == "list") {
    string tag = "ul";
    JsValue props = emptyProps();
    if (node["ordered"].truthy()) {
      tag = "ol";
      JsValue start = node["start"];
      if (!JS.isUndefined(start) && !JS.isNullish(start) && JS.number(start).toInt() != 1) {
        props = JS.object("start", start);
      }
    }
    return h(tag, props, all(node["children"], allowHtml));
  }
  if (t == "listItem") {
    JsValue kids = all(node["children"], allowHtml);
    JsValue checked = node["checked"];
    if (!JS.isUndefined(checked) && !JS.isNullish(checked)) {
      JsValue props = JS.object("type", "checkbox", "disabled", true, "checked", checked.truthy());
      JsValue box = h("input", props, JS.array());
      JS.unshift(kids, box);
    }
    return h("li", emptyProps(), kids);
  }
  if (t == "code") {
    string lang = asString(node["lang"]);
    string value = asString(node["value"]);
    if (value.length > 0 && !value.endsWith("\n")) {
      value = value + "\n";
    }
    JsValue codeProps = emptyProps();
    if (lang.length > 0) {
      JsValue names = JS.array();
      JS.push(names, "language-" + lang);
      codeProps = JS.object("className", names);
    }
    JsValue codeKids = JS.array();
    pushNode(codeKids, hText(value));
    JsValue preKids = JS.array();
    pushNode(preKids, h("code", codeProps, codeKids));
    return h("pre", emptyProps(), preKids);
  }
  if (t == "inlineCode") {
    JsValue kids = JS.array();
    pushNode(kids, hText(asString(node["value"])));
    return h("code", emptyProps(), kids);
  }
  if (t == "html") {
    if (allowHtml) {
      return JS.object("type", "raw", "value", asString(node["value"]));
    }
    return JS.undefined();
  }
  if (t == "definition") {
    return JS.undefined();
  }
  if (t == "text") {
    return hText(asString(node["value"]));
  }
  if (t == "emphasis") {
    return h("em", emptyProps(), all(node["children"], allowHtml));
  }
  if (t == "strong") {
    return h("strong", emptyProps(), all(node["children"], allowHtml));
  }
  if (t == "delete") {
    return h("del", emptyProps(), all(node["children"], allowHtml));
  }
  if (t == "break") {
    return h("br", emptyProps(), JS.array());
  }
  if (t == "link") {
    JsValue props = JS.object("href", asString(node["url"]));
    JsValue title = node["title"];
    if (!JS.isUndefined(title) && !JS.isNullish(title) && asString(title).length > 0) {
      JS.set(props, "title", title);
    }
    return h("a", props, all(node["children"], allowHtml));
  }
  if (t == "image") {
    JsValue props = JS.object("src", asString(node["url"]), "alt", asString(node["alt"]));
    JsValue title = node["title"];
    if (!JS.isUndefined(title) && !JS.isNullish(title) && asString(title).length > 0) {
      JS.set(props, "title", title);
    }
    return h("img", props, JS.array());
  }
  if (t == "linkReference") {
    return h("a", JS.object("href", ""), all(node["children"], allowHtml));
  }
  if (t == "imageReference") {
    return h("img", JS.object("src", "", "alt", asString(node["alt"])), JS.array());
  }
  if (t == "table") {
    return tableToHast(node, allowHtml);
  }
  if (t == "tableRow") {
    return h("tr", emptyProps(), all(node["children"], allowHtml));
  }
  if (t == "tableCell") {
    return h("td", emptyProps(), all(node["children"], allowHtml));
  }
  if (t == "inlineMath") {
    JsValue kids = JS.array();
    pushNode(kids, hText(asString(node["value"])));
    return h("span", classNames("math", "math-inline"), kids);
  }
  if (t == "math") {
    JsValue kids = JS.array();
    pushNode(kids, hText(asString(node["value"])));
    return h("div", classNames("math", "math-display"), kids);
  }
  if (JS.isArray(node["children"])) {
    return all(node["children"], allowHtml);
  }
  return JS.undefined();
}

JsValue tableToHast(JsValue node, bool allowHtml) {
  JsValue rows = node["children"];
  JsValue align = node["align"];
  int n = arrLen(rows);
  JsValue tableKids = JS.array();
  if (n == 0) {
    return h("table", emptyProps(), tableKids);
  }
  JsValue headRow = mapRow(rows[0], align, true, allowHtml);
  JsValue theadKids = JS.array();
  pushNode(theadKids, headRow);
  pushNode(tableKids, h("thead", emptyProps(), theadKids));
  if (n > 1) {
    JsValue bodyKids = JS.array();
    int i = 1;
    while (i < n) {
      pushNode(bodyKids, mapRow(rows[i], align, false, allowHtml));
      i = i + 1;
    }
    pushNode(tableKids, h("tbody", emptyProps(), bodyKids));
  }
  return h("table", emptyProps(), tableKids);
}

JsValue mapRow(JsValue row, JsValue align, bool header, bool allowHtml) {
  JsValue cells = row["children"];
  JsValue kids = JS.array();
  int n = arrLen(cells);
  int i = 0;
  while (i < n) {
    JsValue props = emptyProps();
    if (JS.isArray(align) && i < arrLen(align)) {
      JsValue a = align[i];
      if (a is string) {
        props = JS.object("align", a);
      }
    }
    string tag = "td";
    if (header) {
      tag = "th";
    }
    pushNode(kids, h(tag, props, all(cells[i]["children"], allowHtml)));
    i = i + 1;
  }
  return h("tr", emptyProps(), kids);
}

export JsValue toHast(JsValue tree, bool allowHtml) {
  JsValue out = one(tree, allowHtml);
  if (nodeType(out) == "root") {
    return out;
  }
  JsValue kids = JS.array();
  if (!JS.isUndefined(out) && !JS.isNullish(out)) {
    if (JS.isArray(out)) {
      return hRoot(out);
    }
    pushNode(kids, out);
  }
  return hRoot(kids);
}
